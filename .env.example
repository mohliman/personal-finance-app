PORT=4200
HOST=127.0.0.1
# Production: set NODE_ENV=production, HOST=0.0.0.0 and APP_ORIGIN=https://your-domain
# Use a persistent volume for DATABASE_PATH.
DATABASE_PATH=./data/app.sqlite

# Free Render hosting uses a separate free Turso database per app.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=configure-only-in-Render
# Retain the existing Vercel address while the Node server runs on Render.
# ADDITIONAL_APP_ORIGINS=https://personal-finance-ui.vercel.app
